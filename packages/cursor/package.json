  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "version.cjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitgenetics/aitools.git",
    "directory": "packages/cursor"
