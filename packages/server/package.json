{
  "name": "@aitools/server",
  "version": "0.1.0",
  "description": "Registry server for AITools packages",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "node --watch --import tsx src/index.ts",
