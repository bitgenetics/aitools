{
  "name": "@bitgenetics/aitools-server",
  "version": "2.3.1",
  "private": true,
  "description": "Registry server for AITools packages",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitgenetics/aitools.git",
    "directory": "packages/server"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node --watch --import tsx src/index.ts",
    "debug": "node --inspect=9229 --import tsx src/index.ts",
    "debug:watch": "node --watch --inspect=9229 --import tsx src/index.ts",
    "start": "node dist/index.js",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "test": "jest"
  },
  "author": {
    "name": "Nucleic Logic Studios, LLC",
