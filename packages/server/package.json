  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@bitgenetics/aitools-core": "*",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.8.5",
    "pg": "^8.20.0",
    "semver": "^7.7.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/pg": "^8.20.0",
    "@types/semver": "^7.7.1",
