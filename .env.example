# ai-tools registry — environment variables
# Copy this file to .env and fill in real values before running.
# NEVER commit .env to version control.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4873
HOST=0.0.0.0

# Directory where tool data is persisted (filesystem storage backend).
AI_TOOLS_DATA_DIR=/data

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ── Registry access ───────────────────────────────────────────────────────────
# private (default) — all read endpoints require auth
# public            — reads are open; private-flagged tools are hidden from guests
REGISTRY_ACCESS=private

# ── Auth backend ──────────────────────────────────────────────────────────────
# simple   (default) — static tokens from AI_TOOLS_PUBLISHER_TOKENS / AI_TOOLS_ADMIN_TOKEN
# database           — Postgres-backed user accounts + API tokens (requires DATABASE_URL)
# oidc               — external IdP (requires OIDC_ISSUER + OIDC_AUDIENCE)
AUTH_BACKEND=simple

# Admin token for /portal/admin access (simple mode).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_TOOLS_ADMIN_TOKEN=change-me-replace-with-random-secret

# Publisher tokens (simple mode). JSON map of token → { userId, orgs }.
# Example: {"my-token":{"userId":"alice","orgs":["@myorg"]}}
AI_TOOLS_PUBLISHER_TOKENS=

# ── Database (AUTH_BACKEND=database) ─────────────────────────────────────────
DATABASE_URL=postgresql://ai_tools:CHANGE_ME@localhost:5432/ai_tools

# Postgres credentials used by docker-compose postgres service
POSTGRES_DB=ai_tools
POSTGRES_USER=ai_tools
POSTGRES_PASSWORD=CHANGE_ME

# ── OIDC (AUTH_BACKEND=oidc) ──────────────────────────────────────────────────
# OIDC_ISSUER=https://accounts.example.com
# OIDC_AUDIENCE=ai-tools-registry
# OIDC_ADMIN_ROLE=registry-admin
# OIDC_ORG_CLAIM=groups

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Leave empty to deny all cross-origin requests.
# Example: https://app.example.com,https://admin.example.com
CORS_ORIGINS=

# ── Storage backend ───────────────────────────────────────────────────────────
# filesystem (default) | azure | s3
STORAGE_BACKEND=filesystem

# Azure Blob Storage (STORAGE_BACKEND=azure)
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
# AZURE_STORAGE_CONTAINER=ai-tools

# AWS S3 (STORAGE_BACKEND=s3)
# AWS_S3_BUCKET=my-ai-tools-bucket
# AWS_REGION=us-east-1

# ── Upstream registries ───────────────────────────────────────────────────────
# Comma-separated "name=url" pairs. Results are merged with local results.
# UPSTREAMS=public=https://registry.ai-tools.dev
